# Скопируй в .env и раскомментируй нужное. Файл .env в git не попадает.

# Вход по паролю: логин:пароль через запятую (без запятых в паролях).
# Пусто = без входа (удобно локально). Для хостинга ОБЯЗАТЕЛЬНО задай.
#USERS=mark:ПРИДУМАЙ_ПАРОЛЬ,friend:ДРУГОЙ_ПАРОЛЬ

# Ключ для интеграций (n8n): заголовок X-API-Key. Необязателен.
#API_KEY=

# Куда слать события (n8n webhook), пусто = выключено
#WEBHOOK_URL=

#DB_PATH=crm.db
# Подпись сессий. Пусто = создаётся файл .secret рядом с базой
#SECRET_KEY=

# --- Telegram Mini App (вход без пароля по Telegram ID) ---
#BOT_TOKEN=123456:AA...        # токен от @BotFather
#TG_ADMINS=111111111,222222222  # Telegram ID вас двоих (узнать: написать боту, он ответит, или @userinfobot)
#WEBAPP_URL=https://crm.example.com  # публичный HTTPS-адрес CRM
